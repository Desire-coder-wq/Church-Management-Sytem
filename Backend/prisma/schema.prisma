generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Church {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  groups    Group[]
  members   Member[]
  users     User[]
}

model User {
  id           String       @id @default(cuid())
  fullName     String
  email        String       @unique
  passwordHash String
  role         Role         @default(STAFF)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  churchId     String?
  collections  Collection[]
  church       Church?      @relation(fields: [churchId], references: [id])

  @@index([email])
  @@index([role])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  churchId    String
  church      Church   @relation(fields: [churchId], references: [id])
  members     Member[]

  @@unique([churchId, name])
}

model Member {
  id            String            @id @default(cuid())
  fullName      String
  phone         String            @unique
  groupId       String
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  churchId      String
  church        Church            @relation(fields: [churchId], references: [id])
  group         Group             @relation(fields: [groupId], references: [id])
  pledges       Pledge[]
  notifications SmsNotification[]

  @@index([fullName])
  @@index([phone])
  @@index([groupId])
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  description  String?
  targetAmount Decimal        @db.Decimal(14, 2)
  startDate    DateTime
  endDate      DateTime
  status       CampaignStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  churchId     String
  church       Church         @relation(fields: [churchId], references: [id])
  pledges      Pledge[]

  @@unique([churchId, name])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model Pledge {
  id          String       @id @default(cuid())
  memberId    String
  campaignId  String
  amount      Decimal      @db.Decimal(14, 2)
  dueDate     DateTime
  status      PledgeStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  collections Collection[]
  campaign    Campaign     @relation(fields: [campaignId], references: [id])
  member      Member       @relation(fields: [memberId], references: [id])

  @@unique([memberId, campaignId])
  @@index([memberId])
  @@index([campaignId])
  @@index([status])
  @@index([dueDate])
}

model Collection {
  id              String        @id @default(cuid())
  pledgeId        String
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now())
  method          PaymentMethod
  referenceNumber String?       @unique
  idempotencyKey  String        @unique
  notes           String?
  recordedById    String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pledge          Pledge        @relation(fields: [pledgeId], references: [id])
  recordedBy      User          @relation(fields: [recordedById], references: [id])

  @@index([pledgeId])
  @@index([paymentDate])
  @@index([method])
  @@index([recordedById])
}

model SmsNotification {
  id            String    @id @default(cuid())
  memberId      String
  phone         String
  message       String
  type          SmsType
  status        SmsStatus @default(PENDING)
  providerId    String?
  failureReason String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  member        Member    @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

enum Role {
  ADMIN
  STAFF
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  CLOSED
}

enum PledgeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum SmsType {
  PLEDGE_CREATED
  PAYMENT_RECEIVED
  PAYMENT_REMINDER
  FULLY_PAID
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
FRONTEND_URL="https://church-management-sytem.pages.dev"
API_PUBLIC_URL="https://church-management-sytem.onrender.com/api"

# Paste your live Pesapal credentials here, without brackets or quotes
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# The ID of the one church whose bank or mobile money settlement account is linked to these credentials
PESAPAL_CHURCH_ID=

# Optional; leave empty so the backend registers its Pesapal notification URL
PESAPAL_IPN_ID=

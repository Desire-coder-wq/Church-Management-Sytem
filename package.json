{
  "name": "church-pledge-management-system",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "Backend",
    "Frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev -w Backend\" \"npm run dev -w Frontend\"",
    "build": "npm run build -w Backend && npm run build -w Frontend",
    "test": "npm run test -w Backend"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
